{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun-types"],
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "cogmem": ["../src/public.ts"],
      "cogmem/internal": ["../src/internal.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
